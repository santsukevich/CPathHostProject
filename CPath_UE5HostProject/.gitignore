# Python user specific files
.python-version

# Visual Studio Code user specific files
.vscode/

# Visual Studio user specific files
.vs/
.vsconfig

# JetBrains Rider user specific files
.idea/

# Scripts environment files
.env

### Ignore by file extension

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Python cache files
*.pyc

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.sln.DotSettings.user

### Ignore Unreal generated files

# Binary Files
Binaries/*

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
DDC/*

# Binary Files in Plugins
Plugins/**/Binaries/*

# Compiled source files of Plugins for the engine to use
Plugins/**/Intermediate/*

# Don't ignore plugins' dependencies
!Plugins/**/Source/**/*.lai
!Plugins/**/Source/**/*.la
!Plugins/**/Source/**/*.a
!Plugins/**/Source/**/*.lib
!Plugins/**/Source/**/*.so
!Plugins/**/Source/**/*.dylib
!Plugins/**/Source/**/*.dll
!Plugins/**/Source/**/*.aar

# Build directory and ignore exceptions for shader pipeline caches, icons and splashscreens
Build/*
!Build/IOS/
Build/IOS/*
!Build/Android/
Build/Android/*
!Build/Linux/
Build/Linux/*
!Build/Windows/
Build/Windows/*

# Don't ignore stable shader pipeline caches
!Build/IOS/PipelineCaches/
!Build/Android/PipelineCaches/
!Build/Linux/PipelineCaches/
!Build/Windows/PipelineCaches/

# Don't ignore application icons and splashscreens
!Build/IOS/Resources/
Build/IOS/Resources/*
!Build/IOS/Resources/Graphics/
Build/IOS/Resources/Graphics/*
!Build/IOS/Resources/Graphics/*.png

!Build/Android/res/
Build/Android/res/*
!Build/Android/res/*/
Build/Android/res/*/*
!Build/Android/res/*/*.png

!Build/Linux/*.png

!Build/Windows/*.ico
